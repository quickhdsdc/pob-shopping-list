# 默认按文本处理，仓库内一律存 LF
* text=auto eol=lf

# shell 脚本必须是 LF，CRLF 会导致 "bad interpreter" / "\r: command not found"
*.sh   text eol=lf
*.tsv  text eol=lf

# Windows PowerShell 5.1 按 ANSI 读 .ps1，脚本里有中文时必须带 UTF-8 BOM，
# 且用 CRLF 以免个别版本解析异常
*.ps1  text eol=crlf working-tree-encoding=UTF-8

# PoB 分享码是一整行 base64，别做任何转换
*.pobcode -text
